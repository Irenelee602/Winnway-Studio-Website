{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "winnway-studio-website",
  "main": "worker.js",
  "compatibility_date": "2026-08-10",
  "assets": { "directory": "./", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{
    "binding": "CELLAR_DB",
    "database_name": "winnway-cellar",
    "database_id": "40d09e91-2ecd-4935-be70-ecd5eced89f0"
  }]
}